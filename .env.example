# =====================================================================
# Konfigurasi Booking Service (template: salin ke .env lalu sesuaikan)
# Dibaca oleh:
#   - Spring Boot    (application.yaml -> spring.config.import: optional:file:.env[.properties])
#   - Docker Compose (interpolasi variabel otomatis di docker-compose.yaml)
# Environment variable OS selalu lebih diprioritaskan daripada file ini.
# =====================================================================

# --- Aplikasi ---
APP_PORT=8080
# Set false di production untuk menonaktifkan Swagger UI & /v3/api-docs
SWAGGER_ENABLED=true

# --- Database ---
# DB_HOST/DB_PORT dipakai saat menjalankan aplikasi secara lokal (mvn spring-boot:run).
# Di dalam docker-compose aplikasi selalu terhubung ke host "db" port 5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking
DB_USERNAME=booking
DB_PASSWORD=booking

# --- JWT ---
# Secret HS256, minimal 32 karakter
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=1440
